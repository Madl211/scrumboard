<div class="app-shell">
    {{> header}}

    <div class="page-header">
        <div>
            <p class="eyebrow">Overview</p>
            <h2>Backlogs</h2>
        </div>
        <div class="form-actions">
            <a href="/create-backlog" class="primary-button">Create new backlog</a>
            <a href="/home" class="secondary-button">Back</a>
        </div>
    </div>

    <div class="page-card">
        <div class="backlog-list">
            {{#backlogs}}
            <div class="backlog-item">
                <div>
                    <strong class="backlog-name">{{bezeichnung}}</strong>
                    <div class="muted-text">ID: {{id}}</div>
                </div>
                <a href="/backlog/{{id}}" class="button">Open</a>
            </div>
            {{/backlogs}}

            {{^backlogs}}
            <p class="empty-state">No backlog yet. Create one to get started.</p>
            {{/backlogs}}
        </div>
    </div>
</div>
