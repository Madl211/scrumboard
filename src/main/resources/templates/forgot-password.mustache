<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Forgot Password</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            font-family: "Segoe UI", Tahoma, sans-serif;
            background: linear-gradient(180deg, #eef4ff 0%, #f8fafc 100%);
            color: #111827;
        }
        .container {
            width: min(100%, 460px);
            background: rgba(255,255,255,0.9);
            border: 1px solid rgba(148, 163, 184, 0.24);
            border-radius: 24px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
            padding: 32px 28px;
        }
        h2 { margin: 0 0 12px; }
        p { color: #475467; line-height: 1.6; margin: 0 0 18px; }
        .field { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; font-weight: 600; }
        input {
            width: 100%;
            border: 1px solid rgba(148,163,184,0.5);
            border-radius: 12px;
            padding: 12px 14px;
            font: inherit;
            background: rgba(255,255,255,0.75);
        }
        button {
            width: 100%;
            border: none;
            border-radius: 12px;
            padding: 12px 16px;
            background: linear-gradient(135deg, #4f46e5, #3730a3);
            color: white;
            font-weight: 700;
            cursor: pointer;
        }
        .error, .success {
            border-radius: 12px;
            padding: 12px 14px;
            margin-bottom: 16px;
            font-weight: 600;
        }
        .error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
        .success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
        .link { margin-top: 18px; text-align: center; }
        .link a { color: #4f46e5; text-decoration: none; font-weight: 600; }
        hr { border: none; border-top: 1px solid rgba(148,163,184,0.2); margin: 20px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Forgot Password?</h2>
        <p>Enter your E-Mail or Username.</p>

        {{#errorMessage}}
            <div class="error">{{errorMessage}}</div>
        {{/errorMessage}}

        {{#successMessage}}
            <div class="success">{{successMessage}}</div>
        {{/successMessage}}

        <form method="post" action="/forgot-password">
            <div class="field">
                <label for="usernameEmail">E-Mail or Username</label>
                <input type="text" id="usernameEmail" name="usernameEmail" placeholder="name@example.com" required autofocus>
            </div>
            <button type="submit">Request reset link</button>
        </form>

        <hr>

        <div class="link">
            <a href="/login">Back to login</a>
        </div>
    </div>
</body>
</html>