<div class="app-shell">
    {{> header}}

    <div class="page-header">
        <div>
            <p class="eyebrow">Overview</p>
            <h2>Backlogs</h2>
        </div>
        <a href="/create-backlog" class="primary-button">+ New Backlog</a>
    </div>

    <div class="page-card">
        {{#backlogs}}
        <div class="backlog-item">
            <strong class="backlog-name">{{bezeichnung}}</strong>
            <a href="/backlog/{{id}}" class="button">Open</a>
        </div>
        {{/backlogs}}

        {{^backlogs}}
        <p class="empty-state">No backlog available yet. Create one to get started.</p>
        {{/backlogs}}
    </div>

    <div id="popupOverlay" class="popup-overlay" style="display: flex; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45); justify-content: center; align-items: center; z-index: 50;">
        <div class="popup" style="background: white; border-radius: 20px; max-width: 520px; width: min(90vw, 500px); padding: 28px 24px; text-align: center; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);">
            <h2 style="margin-top: 0; margin-bottom: 10px;">Welcome!</h2>
            <p style="margin: 0; color: #475467; line-height: 1.6;">Please check the urgent tab for tasks that are due soon.</p>
            <button onclick="closePopup()" class="primary-button" style="margin-top: 18px;">Close</button>
        </div>
    </div>

    <script>
        function closePopup() {
            document.getElementById("popupOverlay").style.display = "none";
        }
    </script>
</div>
