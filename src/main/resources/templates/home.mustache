<div style="max-width: 1200px;margin: 2vh auto;font-family: Arial, sans-serif;">
        {{> header}}

        <div style="margin-bottom: 2rem;">
        <h2>Backlogs</h2>
        <p></p>
        <a href="/create-backlog" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Neues Backlog</a>
        <p></p>
        {{#backlogs}}
        <div style="border: 1px solid #ccc; padding: 12px; margin-bottom: 10px; display: flex; justify-content: space-between;">
            <strong style="align-content: center;">{{bezeichnung}}</strong>
            <a href="/backlog/{{id}}" style="background-color: #007bff; color: white; padding: 6px 14px; text-decoration: none; border-radius: 5px; margin-left: 16px;">Öffnen</a>
        </div>
        {{/backlogs}}

        {{^backlogs}}
        <p>Noch keine Backlogs vorhanden. Erstelle einen neuen Backlog!</p>
        {{/backlogs}}
    </div>
    <div>
        <meta charset="UTF-8">
        <style>
        .popup-overlay {
            display: flex;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }  
        .popup {
            background: white;
            padding: 20px;
            border-radius: 10px;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 0 15px rgba(0,0,0,0.3);
        }
        button {
            margin-top: 15px;
            padding: 8px 16px;
            cursor: pointer;
        }
        </style>
    </div>
    <div id="popupOverlay" class="popup-overlay">
        <div class="popup">
            <h2>Welcome!</h2>
            <p>Please check the urgent tab for tasks that are due soon.</p>
            <button onclick="closePopup()">Close</button>
        </div>
    </div>
    <script>
    function closePopup() {
    document.getElementById("popupOverlay").style.display = "none";
    }
    </script>
</div>
