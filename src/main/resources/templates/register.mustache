<div style="max-width: 420px;margin: 2vh auto;font-family: Arial, sans-serif;display: flex;height: 96vh;justify-content: center;align-items: center;flex-direction: column;">
    <h1>Registrieren</h1>
    {{#errorMessage}}
    <div style="color: red; margin-bottom: 10px;">{{errorMessage}}</div>
    {{/errorMessage}}
    <form action="/register" method="post" style="display: flex; flex-direction: column; gap: 10px;">
        <label>
            E-Mail
            <input type="email" name="email" value="{{email}}" required style="width: 100%; padding: 8px;" />
        </label>
        <label>
            Nutzername
            <input type="text" name="username" value="{{username}}" required style="width: 100%; padding: 8px;" />
        </label>
        <label>
            Passwort
            <input type="password" name="password" required style="width: 100%; padding: 8px;" />
        </label>
        <button type="submit" style="padding: 10px;">Registrieren</button>
    </form>
    <p style="margin-top: 16px;">Schon registriert? <a href="/login">Anmelden</a></p>
</div>
