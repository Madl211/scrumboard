<div style="max-width: 1200px;margin: 2vh auto;font-family: Arial, sans-serif;">
    {{> header}}

    <!-- Task Table -->
    <div style="flex: 1;">

        <h2>Tasks</h2>

        <table style="
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #ddd;
        ">

            <thead>
                <tr style="background-color: #f2f2f2;">

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        ID
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Title
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Creator
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Assignees
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Due Date
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Status
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>

                {{#tasks}}
                <tr>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{taskId}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{title}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{creator.username}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{#assignees}}
                            {{username}}{{^last}}, {{/last}}
                        {{/assignees}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{due}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{status}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">

                        <a href="/edit-task/{{taskId}}"
                           style="
                                background-color: #007bff;
                                color: white;
                                padding: 6px 12px;
                                text-decoration: none;
                                border-radius: 5px;
                           ">
                            Edit Task
                        </a>

                    </td>

                </tr>
                {{/tasks}}

            </tbody>
        </table>
    </div>

</div>