<div style="max-width: 1200px;margin: 2vh auto;font-family: Arial, sans-serif;">
    
    <div style="margin-bottom: 2rem; display: flex; flex-direction: row; align-items: center; justify-content: space-between;">
        
        <h1>Scrum Board</h1>

        <div>
            <a href="/home" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Home</a>
            <a href="/profile" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Profile</a>
            <a href="/search-tasks" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Search</a>
            <a href="/showmessage" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Urgent</a>
        </div>
    </div>

    <!-- Task Table -->
    <div style="flex: 1;">

        <h2>Tasks</h2>

        <table style="
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #ddd;
        ">

            <thead>
                <tr style="background-color: #f2f2f2;">

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        ID
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Title
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Creator
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Assignees
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Due Date
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Status
                    </th>

                    <th style="border: 1px solid #ddd; padding: 8px; text-align: left;">
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>

                {{#tasks}}
                <tr>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{taskId}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{title}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{creator.username}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{#assignees}}
                            {{username}}{{^last}}, {{/last}}
                        {{/assignees}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{due}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">
                        {{status}}
                    </td>

                    <td style="border: 1px solid #ddd; padding: 8px;">

                        <a href="/edit-task/{{taskId}}"
                           style="
                                background-color: #007bff;
                                color: white;
                                padding: 6px 12px;
                                text-decoration: none;
                                border-radius: 5px;
                           ">
                            Edit Task
                        </a>

                    </td>

                </tr>
                {{/tasks}}

            </tbody>
        </table>
    </div>

</div>