<div class="app-shell">
    {{> header}}

    <div class="page-card">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">Notifications</p>
                <h2>Urgent Tasks</h2>
            </div>
        </div>

        <div class="table-shell" style="margin-top: 18px;">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Creator</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {{#tasks}}
                    <tr>
                        <td>{{taskId}}</td>
                        <td>{{title}}</td>
                        <td>{{creator.username}}</td>
                        <td>{{due}}</td>
                        <td><span class="status-pill">{{status}}</span></td>
                    </tr>
                    {{/tasks}}
                </tbody>
            </table>
        </div>
    </div>
</div>