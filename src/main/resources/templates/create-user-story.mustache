<div class="app-shell">
    {{> header}}

    <div class="page-card" style="max-width: 760px; margin: 0 auto;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">User Stories</p>
                <h2>Create New User Story</h2>
            </div>
        </div>

        <form action="/create-user-story" method="post" class="modern-form" style="margin-top: 18px;">
            <div class="field">
                <label for="titel">Title</label>
                <input type="text" id="titel" name="titel" required>
            </div>

            <div class="field">
                <label for="beschreibung">Description</label>
                <textarea id="beschreibung" name="beschreibung" rows="4"></textarea>
            </div>

            <div class="field">
                <label>Status</label>
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="status" value="0" checked>Todo</label>
                    <label class="choice-option"><input type="radio" name="status" value="1">In Progress</label>
                    <label class="choice-option"><input type="radio" name="status" value="3">Review</label>
                    <label class="choice-option"><input type="radio" name="status" value="4">Test</label>
                    <label class="choice-option"><input type="radio" name="status" value="2">Completed</label>
                </div>
            </div>

            <div class="field">
                <label for="backlog">Backlog</label>
                <select name="backlog" id="backlog">
                    {{#backlogs}}
                        <option value="{{id}}">{{bezeichnung}}</option>
                    {{/backlogs}}
                </select>
            </div>

            <div class="field">
                <label>Priority</label>
                <div class="checklist">
                    <div class="check-item"><span>Low</span><span class="muted-text">(can be edited later)</span></div>
                </div>
                <input type="hidden" name="priority" value="0">
            </div>

            {{#showErrorMessage}}
                <div class="error-box">Title shouldn't be empty</div>
            {{/showErrorMessage}}

            <div class="field">
                <label>Assign tasks</label>
                <div class="checklist">
                    {{#tasks}}
                    <label class="check-item" for="task-{{taskId}}">
                        <input type="checkbox" id="task-{{taskId}}" name="tasks" value="{{taskId}}">
                        <span>{{title}}</span>
                    </label>
                    {{/tasks}}
                    {{^tasks}}
                    <p class="empty-state" style="margin: 0;">No task found.</p>
                    {{/tasks}}
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="success-button">Create User Story</button>
                <a href="{{cancelPath}}" class="secondary-button">Cancel</a>
            </div>
        </form>
    </div>
</div>