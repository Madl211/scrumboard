<style>
    :root {
        --bg: #f3f6fb;
        --panel: rgba(255, 255, 255, 0.9);
        --panel-strong: #ffffff;
        --primary: #4f46e5;
        --primary-dark: #3730a3;
        --primary-soft: #eef2ff;
        --accent: #14b8a6;
        --accent-soft: #ecfeff;
        --danger: #ef4444;
        --text: #111827;
        --muted: #667085;
        --border: rgba(148, 163, 184, 0.24);
        --shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text);
        background: linear-gradient(180deg, #eef4ff 0%, #f8fafc 100%);
    }

    a {
        text-decoration: none;
    }

    .app-shell {
        max-width: 1280px;
        margin: 28px auto 40px;
        padding: 0 20px;
    }

    .topbar {
        background: rgba(15, 23, 42, 0.96);
        color: #ffffff;
        border-radius: 24px;
        padding: 18px 24px;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 26px;
    }

    .brand {
        font-size: clamp(1.5rem, 2vw, 2rem);
        font-weight: 800;
        letter-spacing: 0.04em;
    }

    .topbar-nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
    }

    .nav-button,
    .button,
    .primary-button,
    .secondary-button,
    .success-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .nav-button,
    .button,
    .primary-button {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: #ffffff;
        box-shadow: 0 10px 20px rgba(79, 70, 229, 0.18);
    }

    .secondary-button {
        background: #e2e8f0;
        color: var(--text);
        border-color: rgba(148, 163, 184, 0.2);
    }

    .success-button {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }

    .nav-button:hover,
    .button:hover,
    .primary-button:hover,
    .secondary-button:hover,
    .success-button:hover {
        transform: translateY(-1px);
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .eyebrow {
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
    }

    .page-header h2,
    .page-card h2,
    .board-column h2,
    .auth-card h1,
    .auth-card h2 {
        margin: 0;
    }

    .page-card,
    .board-column,
    .auth-card,
    .form-card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 22px;
        box-shadow: var(--shadow);
        backdrop-filter: blur(4px);
    }

    .page-card {
        padding: 22px;
    }

    .backlog-list {
        display: grid;
        gap: 14px;
    }

    .backlog-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px 18px;
    }

    .backlog-name {
        font-size: 1.05rem;
        font-weight: 700;
    }

    .empty-state {
        color: var(--muted);
        padding: 18px 8px;
        border: 1px dashed rgba(148, 163, 184, 0.7);
        border-radius: 10px;
        text-align: center;
        background: rgba(255, 255, 255, 0.5);
    }

    .board-layout {
        display: grid;
        grid-template-columns: repeat(5, minmax(220px, 1fr));
        gap: 16px;
        margin-top: 18px;
    }

    .board-column {
        padding: 18px 14px;
        min-height: 420px;
        background: linear-gradient(180deg, rgba(255,255,255,0.94), rgba(248,250,252,0.92));
    }

    .column-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        color: var(--text);
    }

    .column-tag {
        font-size: 0.8rem;
        background: var(--primary-soft);
        color: var(--primary-dark);
        border-radius: 999px;
        padding: 4px 8px;
        font-weight: 700;
    }

    .story-card,
    .task-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 14px;
        margin-bottom: 12px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    }

    .story-header,
    .task-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .priority-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 74px;
        border-radius: 999px;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 4px 9px;
        text-transform: uppercase;
    }

    .priority-low { background: #22c55e; }
    .priority-medium { background: #f59e0b; }
    .priority-high { background: #ef4444; }

    .task-card p,
    .story-card p,
    .muted-text {
        color: var(--muted);
    }

    .meta-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-top: 12px;
        font-size: 0.85rem;
        color: var(--muted);
    }

    .auth-shell {
        min-height: 95vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background:
            radial-gradient(circle at top left, rgba(79, 70, 229, 0.18), transparent 30%),
            radial-gradient(circle at bottom right, rgba(20, 184, 166, 0.15), transparent 32%),
            linear-gradient(180deg, #eef4ff 0%, #f8fafc 100%);
    }

    .auth-card {
        width: min(100%, 460px);
        padding: 32px 28px 26px;
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(240,244,255,0.92));
        border: 1px solid rgba(79, 70, 229, 0.16);
        border-radius: 28px;
        box-shadow: 0 24px 48px rgba(79, 70, 229, 0.12), 0 10px 24px rgba(15, 23, 42, 0.1);
    }

    .auth-card::before {
        content: "";
        position: absolute;
        inset: auto -50px -60px auto;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(79,70,229,0.18), transparent 65%);
        pointer-events: none;
    }

    .auth-brand {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-weight: 800;
        color: var(--primary-dark);
        background: rgba(79, 70, 229, 0.08);
        border: 1px solid rgba(79, 70, 229, 0.14);
        border-radius: 999px;
        padding: 8px 12px;
        margin-bottom: 14px;
    }

    .auth-header {
        margin-bottom: 10px;
        position: relative;
        z-index: 1;
    }

    .auth-card h1 {
        font-size: clamp(2rem, 2vw, 2.4rem);
        line-height: 1.1;
        margin: 0;
        color: var(--text);
    }

    .auth-card form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-top: 16px;
        position: relative;
        z-index: 1;
    }

    .auth-links,
    .auth-footer {
        position: relative;
        z-index: 1;
    }

    .auth-links {
        margin-top: 14px;
        text-align: right;
    }

    .auth-footer {
        margin-top: 18px;
        text-align: center;
        color: var(--muted);
    }

    .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-weight: 600;
        color: var(--text);
    }

    .field input,
    .field textarea,
    .field select {
        width: 100%;
        border: 1px solid rgba(79, 70, 229, 0.18);
        border-radius: 12px;
        background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(238,242,255,0.9));
        padding: 12px 14px;
        font: inherit;
        color: var(--text);
        box-shadow: inset 0 1px 2px rgba(79, 70, 229, 0.05);
    }

    .field input:focus,
    .field textarea:focus,
    .field select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 10px;
    }

    .modern-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .choice-group {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 10px;
    }

    .choice-option {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        background: rgba(79, 70, 229, 0.04);
        border: 1px solid rgba(79, 70, 229, 0.15);
        border-radius: 12px;
        font-weight: 600;
        color: var(--text);
    }

    .choice-option input {
        accent-color: var(--primary);
    }

    .checklist {
        display: grid;
        gap: 8px;
    }

    .check-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid rgba(148, 163, 184, 0.24);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.6);
    }

    .table-shell {
        overflow-x: auto;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: var(--shadow);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 14px 16px;
        text-align: left;
        border-bottom: 1px solid rgba(148, 163, 184, 0.22);
    }

    thead th {
        background: rgba(79, 70, 229, 0.06);
        color: var(--text);
        font-weight: 700;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 0.75rem;
        font-weight: 700;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary-dark);
    }

    .error-box,
    .success-box {
        border-radius: 12px;
        padding: 12px 14px;
        margin-top: 10px;
        font-weight: 600;
    }

    .error-box {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .success-box {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .inline-link {
        color: var(--primary);
        font-weight: 600;
    }

    @media (max-width: 900px) {
        .board-layout {
            grid-template-columns: repeat(2, minmax(220px, 1fr));
        }
    }

    @media (max-width: 640px) {
        .topbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .topbar-nav {
            justify-content: flex-start;
        }

        .page-header,
        .backlog-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .board-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="topbar">
    <div class="brand">Scrum Board</div>

    <div class="topbar-nav">
        <a href="/home" class="nav-button">Home</a>
        <a href="/profile" class="nav-button">Profile</a>
        <a href="/search-tasks" class="nav-button">Search</a>
        <a href="/showmessage" class="nav-button">Urgent</a>
    </div>
</div>
