<div style="max-width: 600px;margin: 2vh auto;font-family: Arial, sans-serif;">
    <h1>Create New Task</h1>
    
    <form action="/create-task" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
            <label for="title" style="display: block; margin-bottom: 0.5rem;">Title:</label>
            <input type="text" id="title" name="title" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        
        <div>
            <label for="description" style="display: block; margin-bottom: 0.5rem;">Description:</label>
            <textarea id="description" name="description" rows="4" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;"></textarea>
        </div>
        
        <div>
            <label for="startDate" style="display: block; margin-bottom: 0.5rem;">Start Date:</label>
            <input type="date" id="startDate" name="startDate" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        
        <div>
            <label for="dueDate" style="display: block; margin-bottom: 0.5rem;">Due Date:</label>
            <input type="date" id="dueDate" name="dueDate" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        
        <div>
            <label for="estimatedTime" style="display: block; margin-bottom: 0.5rem;">Estimated Time (hours):</label>
            <input type="number" id="estimatedTime"  required name="estimatedTime" min="0" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>

        <div>
            <label for="estimatedTime" style="display: block; margin-bottom: 0.5rem;">Status:</label>
            <div style="display: flex; flex-direction: row; justify-content: space-between; ">
                <div>
                    <input type="radio" id="statusTodo" name="status" value = 0>
                    <label for="statusTodo">Todo</label> 
                </div>
                <div>
                    <input type="radio" id="statusInProg" name="status" value = 1>
                    <label for="statusInProg">In Progress</label> 
                </div>
                <div>
                    <input type="radio" id="statusTodo" name="status" value = 2>
                    <label for="statusCompleted">Completed</label> 
                </div>
            </div>
        </div>
        <div>
    <label style="display: block; margin-bottom: 0.5rem;">Priorität:</label>
    <div style="display: flex; flex-direction: row; justify-content: space-between;">
        <div>
            <input type="radio" id="priorityLow" name="priority" value="0" checked>
            <label for="priorityLow">Niedrig</label>
        </div>
        <div>
            <input type="radio" id="priorityMedium" name="priority" value="1">
            <label for="priorityMedium">Mittel</label>
        </div>
        <div>
            <input type="radio" id="priorityHigh" name="priority" value="2">
            <label for="priorityHigh">Hoch</label>
        </div>
    </div>
    </div>
        <div>
            <label for="backlog" style="display: block; margin-bottom: 0.5rem;">Backlog:</label>
            <select name="backlog" id="backlog" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                {{#backlogs}}
                    <option value="{{id}}">{{bezeichnung}}</option>
                {{/backlogs}}
            </select>
        </div>

        <div>
            <label style="display: block; margin-bottom: 0.5rem;">Assignees:</label>
            {{#accounts}}
            <div style="margin-bottom: 0.5rem;">
                <input type="checkbox" id="assignee-{{accountId}}" name="assignees" value="{{accountId}}">
                <label for="assignee-{{accountId}}">{{username}} ({{email}})</label>
            </div>
            {{/accounts}}
        </div>
        
        <div style="display: flex; gap: 1rem;">
            <button type="submit" style="background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;">Create Task</button>
            <a href="{{cancelPath}}" style="background-color: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Cancel</a>
        </div>
    </form>
</div>