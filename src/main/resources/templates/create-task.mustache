<div class="app-shell">
    {{> header}}

    <div class="page-card" style="max-width: 760px; margin: 0 auto;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">Tasks</p>
                <h2>Create New Task</h2>
            </div>
        </div>

        <form action="/create-task" method="post" class="modern-form" style="margin-top: 18px;">
            <div class="field">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" required>
            </div>

            <div class="field">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4"></textarea>
            </div>

            <div class="field">
                <label for="startDate">Start Date</label>
                <input type="date" id="startDate" name="startDate">
            </div>

            <div class="field">
                <label for="dueDate">Due Date</label>
                <input type="date" id="dueDate" name="dueDate" required>
            </div>

            <div class="field">
                <label for="estimatedTime">Estimated Time (hours)</label>
                <input type="number" id="estimatedTime" name="estimatedTime" min="0" required>
            </div>

            <div class="field">
                <label>Priority</label>
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="priority" value="0" checked>Low</label>
                    <label class="choice-option"><input type="radio" name="priority" value="1">Medium</label>
                    <label class="choice-option"><input type="radio" name="priority" value="2">High</label>
                </div>
            </div>

            <div class="field">
                <label for="backlog">Backlog</label>
                <select name="backlog" id="backlog">
                    {{#backlogs}}
                        <option value="{{id}}">{{bezeichnung}}</option>
                    {{/backlogs}}
                </select>
            </div>

            <div class="field">
                <label>Status</label>
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="status" value="0" checked>Todo</label>
                    <label class="choice-option"><input type="radio" name="status" value="1">In Progress</label>
                    <label class="choice-option"><input type="radio" name="status" value="3">Review</label>
                    <label class="choice-option"><input type="radio" name="status" value="4">Test</label>
                    <label class="choice-option"><input type="radio" name="status" value="2">Done</label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="success-button">Create Task</button>
                <a href="{{cancelPath}}" class="secondary-button">Cancel</a>
            </div>
        </form>
    </div>
</div>