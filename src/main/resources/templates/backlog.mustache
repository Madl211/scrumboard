                    <strong>{{titel}}</strong>
                    <span style="background-color: {{priorityColor}}; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.8em; font-weight: bold;">{{priorityLabel}}</span>
                </div>
                <p>{{beschreibung}}</p>
                <details style="margin-top: 8px;">
                    <summary style="cursor: pointer; color: #555;">Tasks</summary>
                    <div style="margin-top: 6px;">
                        {{#tasks}}
                        <div style="display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid #eee;">
                            <span>{{title}} ({{statusLabel}})</span>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="background-color: {{priorityColor}}; color: white; padding: 1px 6px; border-radius: 3px; font-size: 0.75em; font-weight: bold;">{{priorityLabel}}</span>
                                <a href="/edit-task/{{taskId}}">Bearbeiten</a>
                            </div>
                        </div>
                        {{/tasks}}
                        {{^tasks}}
                        <p style="color: #888;">Keine Tasks zugeordnet.</p>
                        {{/tasks}}
                    </div>
                </details>
                <div style="margin-top: 8px;">
                    <a href="/edit-user-story/{{id}}">Edit</a>
                </div>
            </div>
            {{/todoUserStories}}
            {{^todoUserStories}}
