                            <span>{{title}} ({{statusLabel}})</span>
                            <a href="/edit-task/{{taskId}}">Edit</a>
                        </div>
                        {{/tasks}}
                        {{^tasks}}
                        <p class="muted-text">No tasks assigned.</p>
                        {{/tasks}}
                    </div>
                </details>
                <div class="meta-row">
                    <span></span>
                    <a href="/edit-user-story/{{id}}">Edit</a>
                </div>
            </div>
            {{/todoUserStories}}
            {{^todoUserStories}}
