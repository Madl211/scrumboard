            <a href="/backlog/{{backlog.id}}/assignees" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Show Contributers</a>
            <a href="/create-task" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Create Task</a>
            <a href="/create-user-story" style="background-color: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Create User Story</a>
        </div>
    </div>

    <div style="display: flex; gap: 1rem; align-items: flex-start;">

