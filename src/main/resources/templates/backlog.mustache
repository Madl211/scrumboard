<div class="app-shell">
    {{> header}}

    <div class="page-header">
        <div>
            <p class="eyebrow">Board</p>
            <h2>{{backlog.bezeichnung}}</h2>
        </div>
        <div class="topbar-nav" style="justify-content: flex-end;">
            <a href="/backlog/{{backlog.id}}/assignees" class="button">Contributors</a>
            <a href="/create-task" class="button">Create Task</a>
            <a href="/create-user-story" class="button">Create User Story</a>
        </div>
    </div>

    <div class="board-layout">
