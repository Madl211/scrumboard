<div style="width: 400px; height: 300px; display: flex; flex-direction: column; justify-content: space-between;">

    <div style="display: flex; justify-content: space-between;">
        <label for="name">Name:</label>
        <input id="name" type="text" value="{{name}}">
    </div>

    <div style="display: flex; justify-content: space-between;">
        <label for="eMail">E-Mail:</label>
        <input id="eMail" type="text" value="{{eMail}}">
    </div>

    <div style="display: flex; justify-content: space-between;">
        <label for="telefonnummer">Telefonnummer:</label>
        <input id="telefonnummer" type="text" value="{{telefonnummer}}">
    </div>

    <div style="display: flex; justify-content: space-between;">
        <label for="ort">Ort:</label>
        <input id="ort" type="text" value="{{ort}}">
    </div>

    <div style="display: flex; justify-content: space-between;">
        <label for="postleitzahl">Postleitzahl:</label>
        <input id="postleitzahl" type="text" value="{{postleitzahl}}">
    </div>

    <div style="display: flex; justify-content: space-between;">
        <label for="strasse">Name:</label>
        <input id="strasse" type="text" value="{{strasse}}">
    </div>

    <div style="display: flex; justify-content: space-between;">
        <label for="hausnummer">Name:</label>
        <input id="hausnummer" type="text" value="{{hausnummer}}">
    </div>

</div>