<div class="app-shell">
    {{> header}}

    <div class="page-card" style="max-width: 540px; margin: 0 auto;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">Account</p>
                <h2>Profile</h2>
            </div>
        </div>

        <form action="/profile" method="post" style="display: flex; flex-direction: column; gap: 12px; margin-top: 18px;">
            <label class="field">
                Name
                <input name="name" type="text" value="{{name}}">
            </label>
            <label class="field">
                Email Address
                <input name="eMail" type="email" value="{{eMail}}">
            </label>
            <label class="field">
                Phone number
                <input name="telefonnummer" type="text" value="{{telefonnummer}}">
            </label>
            <label class="field">
                City
                <input name="ort" type="text" value="{{ort}}">
            </label>
            <label class="field">
                Postal code
                <input name="postleitzahl" type="text" value="{{postleitzahl}}">
            </label>
            <label class="field">
                Street name
                <input name="strasse" type="text" value="{{strasse}}">
            </label>
            <label class="field">
                House number
                <input name="hausnummer" type="text" value="{{hausnummer}}">
            </label>

            <div class="form-actions">
                <button type="submit" class="success-button">Save Profile</button>
            </div>
        </form>

        <div style="margin-top: 18px;">
            <a href="/forgot-password" class="button" style="display: block; width: 100%;">Reset password</a>
        </div>
    </div>
</div>