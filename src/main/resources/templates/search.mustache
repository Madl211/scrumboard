<div class="app-shell">
    {{> header}}

    <div class="page-card" style="margin-bottom: 22px;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">Search</p>
                <h2>Task Search</h2>
            </div>
        </div>

        <form method="GET" action="/search-tasks" class="modern-form" style="margin-top: 16px;">
            <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                <input type="text" name="search" placeholder="Search tasks..." value="{{search}}" style="flex: 1; min-width: 220px;">
                <input type="hidden" name="filter" id="filterInput" value="{{filter}}">
                <button type="submit" class="primary-button">Search</button>
                <button type="button" class="secondary-button" onclick="openFilter()">Filter</button>
            </div>
        </form>

        <div id="filterModal" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.38); display: none; justify-content: center; align-items: center; z-index: 50;">
            <div style="background: white; border-radius: 20px; padding: 24px; width: min(90vw, 420px); box-shadow: 0 18px 40px rgba(15, 23, 42, 0.16);">
                <h3 style="margin-top: 0;">Choose Filter</h3>
                <div class="choice-group" style="margin-top: 12px;">
                    <button type="button" class="secondary-button" onclick="setFilter(0)">TODO</button>
                    <button type="button" class="secondary-button" onclick="setFilter(1)">IN PROGRESS</button>
                    <button type="button" class="secondary-button" onclick="setFilter(3)">REVIEW</button>
                    <button type="button" class="secondary-button" onclick="setFilter(4)">TEST</button>
                    <button type="button" class="secondary-button" onclick="setFilter(2)">COMPLETED</button>
                    <button type="button" class="secondary-button" onclick="setFilter(-1)">All</button>
                </div>
                <div style="margin-top: 18px; text-align: right;">
                    <button type="button" class="button" onclick="closeFilter()">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="page-card">
        <h2 style="margin-top: 0; margin-bottom: 18px;">Tasks</h2>
        <div class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Creator</th>
                        <th>Assignees</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#tasks}}
                    <tr>
                        <td>{{taskId}}</td>
                        <td>{{title}}</td>
                        <td>{{creator.username}}</td>
                        <td>{{#assignees}}{{username}}{{^last}}, {{/last}}{{/assignees}}</td>
                        <td>{{due}}</td>
                        <td><span class="status-pill">{{status}}</span></td>
                        <td><a href="/edit-task/{{taskId}}" class="button">Edit</a></td>
                    </tr>
                    {{/tasks}}
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
function openFilter() {
    document.getElementById("filterModal").style.display = "flex";
}

function closeFilter() {
    document.getElementById("filterModal").style.display = "none";
}

function setFilter(value) {
    document.getElementById("filterInput").value = value;
    closeFilter();
    document.getElementById("filterInput").form.submit();
}
</script>