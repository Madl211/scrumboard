<div class="app-shell">
    {{> header}}

    <div class="page-card" style="max-width: 760px; margin: 0 auto;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">Tasks</p>
                <h2>Edit Task</h2>
            </div>
        </div>

        <form action="/edit-task/{{task.taskId}}" method="post" class="modern-form" style="margin-top: 18px;">
            <div class="field">
                <label for="title">Title</label>
                <input type="text" name="title" value="{{task.title}}" required>
            </div>

            <div class="field">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="4">{{task.desc}}</textarea>
            </div>

            <div class="field">
                <label for="startDate">Start Date</label>
                <input type="date" id="startDate" name="startDate" value="{{task.start}}" required>
            </div>

            <div class="field">
                <label for="dueDate">Due Date</label>
                <input type="date" id="dueDate" name="dueDate" value="{{task.due}}" required>
            </div>

            <div class="field">
                <label for="estimatedTime">Estimated Time (hours)</label>
                <input type="number" id="estimatedTime" required name="estimatedTime" min="0" value="{{task.estimatedTime}}">
            </div>

            <div class="field">
                <label for="realTime">Time spent on this Task (hours)</label>
                <input type="number" id="realTime" required name="realTime" min="0" value="{{task.actualTime}}">
            </div>

            <div class="field">
                <label>Status</label>
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="status" value="0" {{#statusIsTodo}}checked{{/statusIsTodo}}>Todo</label>
                    <label class="choice-option"><input type="radio" name="status" value="1" {{#statusIsInProgress}}checked{{/statusIsInProgress}}>In Progress</label>
                    <label class="choice-option"><input type="radio" name="status" value="3" {{#statusIsReview}}checked{{/statusIsReview}}>Review</label>
                    <label class="choice-option"><input type="radio" name="status" value="4" {{#statusIsTest}}checked{{/statusIsTest}}>Test</label>
                    <label class="choice-option"><input type="radio" name="status" value="2" {{#statusIsCompleted}}checked{{/statusIsCompleted}}>Done</label>
                </div>
            </div>

            <div class="field">
                <label>Priority</label>
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="priority" value="0" {{#priorityLow}}checked{{/priorityLow}}>Low</label>
                    <label class="choice-option"><input type="radio" name="priority" value="1" {{#priorityMedium}}checked{{/priorityMedium}}>Medium</label>
                    <label class="choice-option"><input type="radio" name="priority" value="2" {{#priorityHigh}}checked{{/priorityHigh}}>High</label>
                </div>
            </div>

            <div class="field">
                <label for="backlog">Backlog</label>
                <select name="backlog" id="backlog">
                    {{#backlogs}}
                        <option value="{{id}}">{{bezeichnung}}</option>
                    {{/backlogs}}
                </select>
            </div>

            <div class="field">
                <label>Assignees</label>
                <div class="checklist">
                    {{#accounts}}
                    <label class="check-item" for="assignee-{{accountId}}">
                        <input type="checkbox" id="assignee-{{accountId}}" name="assignees" value="{{accountId}}" {{#isAssigned}}checked{{/isAssigned}}>
                        <span>{{username}} ({{email}})</span>
                    </label>
                    {{/accounts}}
                </div>
            </div>

            <input type="hidden" name="oldBacklogId" value="{{task.backlogId}}">
            <div class="form-actions">
                <button type="submit" class="success-button">Edit Task</button>
                <a href="{{cancelPath}}" class="secondary-button">Cancel</a>
            </div>
        </form>
    </div>
</div>