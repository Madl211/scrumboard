<div style="max-width: 600px;margin: 2vh auto;font-family: Arial, sans-serif;">
    <h1>Edit Task</h1>
    
    <form action="/edit-task/{{task.taskId}}" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
        <div>
            <label for="title" style="display: block; margin-bottom: 0.5rem;">Title:</label>
            <input type="text" name="title" value="{{task.title}}" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        
        <div>
            <label for="description" style="display: block; margin-bottom: 0.5rem;">Description:</label>
            <textarea id="description" name="description" rows="4" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">{{task.desc}}</textarea>
        </div>
        
        <div>
            <label for="startDate" style="display: block; margin-bottom: 0.5rem;">Start Date:</label>
            <input type="date" id="startDate" name="startDate" value="{{task.start}}" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        
        <div>
            <label for="dueDate" style="display: block; margin-bottom: 0.5rem;">Due Date:</label>
            <input type="date" id="dueDate" name="dueDate" value="{{task.due}}" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>
        
        <div>
            <label for="estimatedTime" style="display: block; margin-bottom: 0.5rem;">Estimated Time (hours):</label>
            <input type="number" id="estimatedTime" required name="estimatedTime" min="0" value="{{task.estimatedTime}}" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
        </div>

        <div>
            <label for="estimatedTime" style="display: block; margin-bottom: 0.5rem;">Status:</label>
            <div style="display: flex; flex-direction: row; justify-content: space-between; ">
                <div>
                    <input type="radio" id="statusTodo" name="status" value="0" {{#statusIsTodo}}checked{{/statusIsTodo}}>
                    <label for="statusTodo">Todo</label> 
                </div>
                <div>
                    <input type="radio" id="statusInProg" name="status" value="1" {{#statusIsInProgress}}checked{{/statusIsInProgress}}>
                    <label for="statusInProg">In Progress</label> 
                </div>
                <div>
                    <input type="radio" id="statusCompleted" name="status" value="2" {{#statusIsCompleted}}checked{{/statusIsCompleted}}>
                    <label for="statusCompleted">Completed</label> 
                </div>
            </div>
        </div>
        

         <div>
            <label for="backlog" style="display: block; margin-bottom: 0.5rem;">Backlog:</label>
            <select name="backlog" id="backlog" style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
                {{#backlogs}}
                    <option value="{{id}}">{{bezeichnung}}</option>
                {{/backlogs}}
            </select>
        </div>
        
        
        <div>
          <label style="display: block; margin-bottom: 0.5rem;">Assignees:</label>
            {{#accounts}}
            <div style="margin-bottom: 0.5rem;">
                <input type="checkbox" id="assignee-{{accountId}}" name="assignees" value="{{accountId}}" {{#isAssigned}}checked{{/isAssigned}}>
                <label for="assignee-{{accountId}}">{{username}} ({{email}})</label>
            </div>
            {{/accounts}}
        </div>
        <input type="hidden" name="oldBacklogId" value="{{task.backlogId}}">
        <div style="display: flex; gap: 1rem;">
            <button type="submit" style="background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;">Edit Task</button>
            <a href="{{cancelPath}}" style="background-color: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Cancel</a>
        </div>
    </form>
</div>