<div style="max-width: 420px; margin: 40px auto; font-family: Arial, sans-serif;">
    <h1>Anmelden</h1>
    {{#errorMessage}}
    <div style="color: red; margin-bottom: 10px;">{{errorMessage}}</div>
    {{/errorMessage}}
    <form action="/login" method="post" style="display: flex; flex-direction: column; gap: 10px;">
        <label>
            E-Mail
            <input type="email" name="email" value="{{email}}" required style="width: 100%; padding: 8px;" />
        </label>
        <label>
            Passwort
            <input type="password" name="password" required style="width: 100%; padding: 8px;" />
        </label>
        <button type="submit" style="padding: 10px;">Anmelden</button>
    </form>
    <p style="margin-top: 16px;">Noch keinen Account? <a href="/register">Registrieren</a></p>
</div>
