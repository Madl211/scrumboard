<div class="app-shell">
    {{> header}}

    <div class="page-card" style="max-width: 760px; margin: 0 auto;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">User Stories</p>
                <h2>Edit User Story</h2>
            </div>
        </div>

        <form action="/edit-user-story/{{userStory.id}}" method="post" class="modern-form" style="margin-top: 18px;">
            <div class="field">
                <label for="titel">Title</label>
                <input type="text" id="titel" name="titel" value="{{userStory.titel}}" required>
            </div>

            <div class="field">
                <label for="beschreibung">Description</label>
                <textarea id="beschreibung" name="beschreibung" rows="4">{{userStory.beschreibung}}</textarea>
            </div>

            <div class="field">
                <label>Status</label>
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="status" value="0" {{#statusIsTodo}}checked{{/statusIsTodo}}>Todo</label>
                    <label class="choice-option"><input type="radio" name="status" value="1" {{#statusIsInProgress}}checked{{/statusIsInProgress}}>In Progress</label>
                    <label class="choice-option"><input type="radio" name="status" value="3">Review</label>
                    <label class="choice-option"><input type="radio" name="status" value="4">Test</label>
                    <label class="choice-option"><input type="radio" name="status" value="2" {{#statusIsCompleted}}checked{{/statusIsCompleted}}>Completed</label>
                </div>
            </div>

            <div class="field">
                <label for="backlog">Backlog</label>
                <select name="backlog" id="backlog">
                    {{#backlogs}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{bezeichnung}}</option>
                    {{/backlogs}}
                </select>
            </div>

            <div class="field">
                <label>Priority</label>
                {{#isProductOwner}}
                <div class="choice-group">
                    <label class="choice-option"><input type="radio" name="priority" value="0" {{#priorityLow}}checked{{/priorityLow}}>Low</label>
                    <label class="choice-option"><input type="radio" name="priority" value="1" {{#priorityMedium}}checked{{/priorityMedium}}>Medium</label>
                    <label class="choice-option"><input type="radio" name="priority" value="2" {{#priorityHigh}}checked{{/priorityHigh}}>High</label>
                </div>
                {{/isProductOwner}}
                {{^isProductOwner}}
                <div class="check-item">
                    <span>{{#priorityLow}}Low{{/priorityLow}}{{#priorityMedium}}Medium{{/priorityMedium}}{{#priorityHigh}}High{{/priorityHigh}}</span>
                    <span class="muted-text">(Only Product Owner can edit)</span>
                </div>
                <input type="hidden" name="priority" value="{{priorities}}">
                {{/isProductOwner}}
            </div>

            {{#showErrorMessage}}
                <div class="error-box">Title shouldn't be empty</div>
            {{/showErrorMessage}}

            <div class="field">
                <label>Assign tasks</label>
                <div class="checklist">
                    {{#tasks}}
                    <label class="check-item" for="task-{{taskId}}">
                        <input type="checkbox" id="task-{{taskId}}" name="tasks" value="{{taskId}}" {{#isAssigned}}checked{{/isAssigned}}>
                        <span>{{title}}</span>
                    </label>
                    {{/tasks}}
                    {{^tasks}}
                    <p class="empty-state" style="margin: 0;">No task found.</p>
                    {{/tasks}}
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="success-button">Save</button>
                <a href="{{cancelPath}}" class="secondary-button">Cancel</a>
            </div>
        </form>
    </div>
</div>