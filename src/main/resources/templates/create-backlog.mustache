<div class="app-shell">
    {{> header}}

    <div class="page-card" style="max-width: 640px; margin: 0 auto;">
        <div class="page-header" style="margin-bottom: 0;">
            <div>
                <p class="eyebrow">Backlog</p>
                <h2>Create New Backlog</h2>
            </div>
        </div>

        <form action="/create-backlog" method="post" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 18px;">
            <div class="field">
                <label for="bezeichnung">Name</label>
                <input type="text" id="bezeichnung" name="bezeichnung" required>
            </div>

            {{#showErrorMessage}}
                <div class="error-box">Error: wrong input</div>
            {{/showErrorMessage}}

            <div class="form-actions">
                <button type="submit" class="success-button">Create Backlog</button>
                <a href="/home" class="secondary-button">Cancel</a>
            </div>
        </form>
    </div>
</div>