<div style="max-width: 1200px;margin: 2vh auto;font-family: Arial, sans-serif;">
    {{> header}}

    <div style="width: 600px; margin: auto;">
        <h2>Create New Backlog</h2>

        <form action="/create-backlog" method="post" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
                <label for="bezeichnung" style="display: block; margin-bottom: 0.5rem;">Bezeichnung:</label>
                <input type="text" id="bezeichnung" name="bezeichnung" required style="width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px;">
            </div>

            {{#showErrorMessage}}
                <div style="color: red;">Die Eingaben waren fehlerhaft</div>
            {{/showErrorMessage}}
            
            <div style="display: flex; gap: 1rem;">
                <button type="submit" style="background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;">Create Backlog</button>
                <a href="/home" style="background-color: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">Cancel</a>
            </div>
        </form>
    </div>
</div>