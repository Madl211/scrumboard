<div class="app-shell">
    {{> header}}

    <div class="page-header">
        <div>
            <p class="eyebrow">Team</p>
            <h2>{{backlog.bezeichnung}} Assignees</h2>
        </div>
        <div class="form-actions">
            <a href="/backlog/{{backlog.id}}" class="secondary-button">Back to Backlog</a>
            <a href="/backlog/{{backlog.id}}/assignees/add" class="success-button">Add Assignee</a>
        </div>
    </div>

    <div class="table-shell">
        {{#backlogAssignees}}
        <table>
            <thead>
                <tr>
                    <th>User</th>
                    <th>E-Mail</th>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {{#backlogAssignees}}
                <tr>
                    <td><strong>{{username}}</strong></td>
                    <td>{{email}}</td>
                    <td>
                        <span class="status-pill" style="background-color: {{roleColor}}; color: white;">
                            {{role}}
                        </span>
                    </td>
                    <td>
                        <a href="/backlog/{{backlog.id}}/assignees/remove/{{assigneeId}}" style="color: #ef4444; font-weight: 600;" onclick="return confirm('Do you want to remove {{username}}?');">
                            Remove
                        </a>
                    </td>
                </tr>
                {{/backlogAssignees}}
            </tbody>
        </table>
        {{/backlogAssignees}}
    </div>
</div>

<script>
    const reloadDialog = document.getElementById("reload-dialog");
    
    function closeDialog() {
        reloadDialog.close();
    }

    function reloadPage() {
        window.location.reload();
    }

    const timestampOfLastCheckedUpdate = {{timestampOfLastCheckedUpdate}};
    console.log("Initial timestamp: " + timestampOfLastCheckedUpdate);

    function poll() {
        console.log("Polling...");
        fetch("/backlog/{{backlog.id}}/last-update")
            .then((response) => {
                if (response.status !== 200) {
                    throw new Error("Fehler beim Abfragen des Zeitstempels des letzten Updates");
                }
                return response.json();
            })
            .then((response) => {
                if (response.timestamp > timestampOfLastCheckedUpdate) {
                    timestampOfLastCheckedUpdate = response.timestamp;
                    reloadDialog.showModal();
                } else {
                    console.log("No Update: Timestamp -> " + response.timestamp);
                }
            })
            .catch((error) => {
                console.error(error);
            });
    }

    setInterval(poll, 2000);
</script>